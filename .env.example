# aktcl.com — settings for the enquiry API (api/, POST /api/enquiry).
#
# The website itself needs NO environment variables. Everything below is read by
# the Azure Static Web Apps managed function at run time, so in production these
# are APPLICATION SETTINGS on the Static Web App — never files in git:
#
#   az staticwebapp appsettings set -n aktcl-web -g rg-aktcl --setting-names KEY=value
#
# For local testing copy the values into api/local.settings.json (git-ignored;
# start from api/local.settings.example.json). Full guide: docs/enquiry-api.md
#
# An enquiry is delivered to every sink configured below. Configure at least one,
# ideally both: with none the form answers "could not be sent" (HTTP 503).

# --- Sink 1: Azure Table Storage (the durable record) -------------------------
# Connection string of any general-purpose storage account (Portal > Storage
# account > Security + networking > Access keys). The "enquiries" table is created
# on first use. An existing account can be reused; nothing else is touched.
# Local testing with Azurite: UseDevelopmentStorage=true
ENQUIRY_STORAGE_CONNECTION_STRING=

# --- Sink 2: email over SMTP (the notification) -------------------------------
# All five of SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS and ENQUIRY_TO must be set
# or email is treated as not configured.
#
# Host of the mail provider's SMTP submission service.
SMTP_HOST=
# 587 (STARTTLS, recommended) or 465 (implicit TLS). Port 25 is blocked from Azure.
SMTP_PORT=587
# Mailbox or SMTP user that authenticates the send.
SMTP_USER=
# Its password or app password. Treat as a secret.
SMTP_PASS=
# Where enquiries are delivered. Several addresses: separate with commas.
ENQUIRY_TO=
# Optional. Bare address shown as the sender; defaults to SMTP_USER. Most providers
# only accept an address the SMTP user is allowed to send as.
ENQUIRY_FROM=
