{
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    {
      "route": "/api/enquiry",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/geo/*",
      "headers": { "Cache-Control": "public, max-age=604800" }
    },
    {
      "route": "/og-image.jpg",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/favicon.svg",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/favicon.ico",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/favicon-96x96.png",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/apple-touch-icon.png",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/icon-192.png",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/icon-512.png",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/logo.png",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/logo.svg",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/site.webmanifest",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/sitemap.xml",
      "headers": { "Cache-Control": "public, max-age=3600" }
    },
    {
      "route": "/robots.txt",
      "headers": { "Cache-Control": "public, max-age=3600" }
    },
    {
      "route": "/llms.txt",
      "headers": { "Cache-Control": "public, max-age=3600" }
    },
    {
      "route": "/downloads/*",
      "headers": { "Cache-Control": "public, max-age=86400" }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN",
    "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()",
    "Strict-Transport-Security": "max-age=31536000",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'sha256-INLINE-SCRIPTS'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  },
  "mimeTypes": {
    ".avif": "image/avif",
    ".pdf": "application/pdf",
    ".webp": "image/webp",
    ".webmanifest": "application/manifest+json"
  }
}
